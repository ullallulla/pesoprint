# Copy to apps/web/.env for local development.
# Where the web server reaches the API (server-side only, never sent to the browser).
API_URL=http://localhost:3001
# Public address of the site (canonical URLs, Open Graph tags, sitemap.xml).
SITE_URL=http://localhost:5173

# Clerk (Dashboard → API keys). Read at runtime by the web server.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Same value as INTERNAL_API_SECRET in the API (optional locally). Lets download requests pass on the visitor's IP.
# INTERNAL_API_SECRET=<openssl rand -hex 32>

# PostHog analytics (optional; Project settings → Project API key). Without it there's no analytics and no cookie banner.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
