# Copy to apps/api/.env for local development. Matches docker-compose.yml.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://pesoprint:pesoprint@localhost:5432/pesoprint
# Separate database for integration tests (created automatically by docker compose).
TEST_DATABASE_URL=postgres://pesoprint:pesoprint@localhost:5432/pesoprint_test
LOG_REQUESTS=true

# Clerk (Dashboard → API keys). Used to verify session tokens sent by the web app.
CLERK_SECRET_KEY=sk_test_...
# Clerk (Dashboard → Webhooks → your endpoint → Signing secret). Optional locally; without it the webhook answers 503.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Origins allowed to send session tokens (comma-separated).
WEB_ORIGINS=http://localhost:5173

# Downloads. Both optional locally; set them on staging and production.
# The same random value in the API and the web app (lets the web app pass on visitors' IPs for rate limits):
# INTERNAL_API_SECRET=<openssl rand -hex 32>
# Key for anonymising IPs in download logs:
# IP_HASH_SECRET=<openssl rand -hex 32>

# Payments: Stripe in test mode (Dashboard → Developers → API keys). Optional locally; without it
# checkout answers 503. Stripe sends buyers back to the first of WEB_ORIGINS.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: printed by `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# locally, or Dashboard → Developers → Webhooks → your endpoint on staging. Optional locally: the order
# page also asks Stripe whether the order was paid.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Order emails: Resend (resend.com → API Keys, "Sending access" for the verified domain). Optional
# locally; without it emails are printed to the API's console instead. In production they wait in the
# outbox until it's set. Links in emails point to the first of WEB_ORIGINS.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Pesoprint <orders@pesoprint.allulab.eu>"
# EMAIL_REPLY_TO=support@allulab.eu
# EMAIL_SUBJECT_PREFIX="[Staging] "

# File storage: Cloudflare R2 (any S3-compatible service works). Optional locally; without it the
# upload endpoints answer 503. Set all of these or none. See README → "File storage".
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BUCKET=pesoprint-dev-public
# S3_PRIVATE_BUCKET=pesoprint-dev-private
# PUBLIC_ASSETS_URL=https://pub-<id>.r2.dev

# Error reporting: Sentry (EU), the DSN of the project pesoprint-api (Project settings → Client Keys).
# Optional; usually left unset locally, so development errors don't reach Sentry.
# SENTRY_DSN=https://<key>@o<org id>.ingest.de.sentry.io/<project id>
# SENTRY_ENVIRONMENT=staging
