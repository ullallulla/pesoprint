# Copy to apps/api/.env for local development. Matches docker-compose.yml.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://pesoprint:pesoprint@localhost:5432/pesoprint
# Separate database for integration tests (created automatically by docker compose).
TEST_DATABASE_URL=postgres://pesoprint:pesoprint@localhost:5432/pesoprint_test
LOG_REQUESTS=true

# Clerk (Dashboard → API keys). Used to verify session tokens sent by the web app.
CLERK_SECRET_KEY=sk_test_...
# Clerk (Dashboard → Webhooks → your endpoint → Signing secret). Optional locally; without it the webhook answers 503.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Origins allowed to send session tokens (comma-separated).
WEB_ORIGINS=http://localhost:5173

# File storage: Cloudflare R2 (any S3-compatible service works). Optional locally; without it the
# upload endpoints answer 503. Set all of these or none. See README → "File storage".
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BUCKET=pesoprint-dev-public
# S3_PRIVATE_BUCKET=pesoprint-dev-private
# PUBLIC_ASSETS_URL=https://pub-<id>.r2.dev
