{
    "name": "@app/api",
    "version": "0.0.0",
    "private": true,
    "description": "Pesoprint HTTP API (Hono + Drizzle + Postgres).",
    "type": "module",
    "scripts": {
        "dev": "vpx --watch src/index.ts",
        "build": "vp pack",
        "start": "node dist/index.mjs",
        "test": "vp test",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "vpx src/migrate.ts",
        "db:seed": "vpx src/seed.ts",
        "db:studio": "drizzle-kit studio",
        "storage:cleanup": "vpx src/clean-storage.ts",
        "users:sync": "vpx src/sync-users.ts"
    },
    "dependencies": {
        "@app/shared": "workspace:*",
        "@aws-sdk/client-s3": "catalog:",
        "@aws-sdk/s3-request-presigner": "catalog:",
        "@clerk/backend": "catalog:",
        "@gltf-transform/core": "catalog:",
        "@gltf-transform/extensions": "catalog:",
        "@gltf-transform/functions": "catalog:",
        "@hono/node-server": "catalog:",
        "@hono/swagger-ui": "catalog:",
        "@hono/zod-openapi": "catalog:",
        "drizzle-orm": "catalog:",
        "hono": "catalog:",
        "meshoptimizer": "catalog:",
        "pg": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "drizzle-kit": "catalog:",
        "image-size": "catalog:",
        "typescript": "catalog:",
        "vite-plus": "catalog:"
    }
}
