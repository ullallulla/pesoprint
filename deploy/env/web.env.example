# The web server's settings in production (docs/production-environment3.md §6). Copy to
# /opt/pesoprint/env/web.env, chmod 600. No database or R2 credentials here: the web server only talks to the API.

# Inside the stack, not through Cloudflare. API_WAKE_URL stays unset (only staging on Render needs it).
API_URL=http://api:3001
SITE_URL=https://pesoprint.allulab.eu

# Clerk production instance (read at runtime, so the same image fits every environment).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# The same value as in api.env.
INTERNAL_API_SECRET=

# Sentry project pesoprint-web.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# No POSTHOG_* settings: no analytics, no cookie banner.
