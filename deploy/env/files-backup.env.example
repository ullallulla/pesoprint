# The nightly copy of the R2 buckets off Cloudflare (profile files-backup, docs/production-environment3.md §8.2).
# Copy to /opt/pesoprint/env/files-backup.env, chmod 600. restore.sh reads it too.

# The rclone remote "r2": R2 token 3, Object Read only, on the two production buckets.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
FILES_BACKUP_SOURCES=r2:pesoprint-prod-public r2:pesoprint-prod-private

# Where the copy goes. Homelab: /backup, the directory FILES_BACKUP_DIR in the host's .env. Elsewhere any rclone
# remote, e.g. a Hetzner Storage Box over SFTP:
#   RCLONE_CONFIG_BOX_TYPE=sftp, RCLONE_CONFIG_BOX_HOST=…, RCLONE_CONFIG_BOX_USER=…, RCLONE_CONFIG_BOX_KEY_PEM=…
#   FILES_BACKUP_DEST=box:pesoprint
FILES_BACKUP_DEST=/backup
# Files deleted or overwritten in R2 stay in deleted/<day>/ for this many days.
FILES_BACKUP_KEEP_DAYS=30

# healthchecks.io check for this job (period 1 day, grace 2 hours).
HEARTBEAT_URL=https://hc-ping.com/<uuid>

# When the nightly copy runs, in Europe/Helsinki time.
FILES_BACKUP_AT=03:30
