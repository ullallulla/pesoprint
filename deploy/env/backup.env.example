# The nightly database backup (profile backup, docs/production-environment3.md §8.1). Copy to
# /opt/pesoprint/env/backup.env, chmod 600. restore.sh reads it too (all but DATABASE_URL).

DATABASE_URL=postgres://pesoprint:<the password from postgres.env>@postgres:5432/pesoprint

# The rclone remote "r2": R2 token 2, Object Read & Write on the backups bucket only.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
BACKUP_TARGET=r2:pesoprint-prod-backups

# The public key (age1…) from `age-keygen`. The private key is never on this host: password manager plus one
# offline copy.
AGE_RECIPIENT=age1...

# healthchecks.io check for this job (period 1 day, grace 2 hours). Pinged after each nightly backup.
HEARTBEAT_URL=https://hc-ping.com/<uuid>

# When the nightly backup runs, in Europe/Helsinki time.
BACKUP_AT=03:00
