# The API's settings in production (docs/production-environment3.md §6). Copy to /opt/pesoprint/env/api.env,
# chmod 600. New secrets for production: don't reuse staging's.
NODE_ENV=production
DATABASE_URL=postgres://pesoprint:<the password from postgres.env>@postgres:5432/pesoprint

# Clerk production instance.
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
WEB_ORIGINS=https://pesoprint.allulab.eu

# openssl rand -hex 32. INTERNAL_API_SECRET is the same in web.env.
INTERNAL_API_SECRET=
IP_HASH_SECRET=

# The "production preview" Stripe Sandbox until go-live (sk_test_…), then live keys and the live endpoint's secret.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend: a production key with Sending access for pesoprint.allulab.eu.
RESEND_API_KEY=re_...
EMAIL_FROM="Pesoprint <orders@pesoprint.allulab.eu>"
# Where replies to order emails go, e.g. a support inbox. May be empty: replies then go to EMAIL_FROM.
EMAIL_REPLY_TO=
# Until go-live, so preview emails stand out. May be empty (and should be, after go-live).
EMAIL_SUBJECT_PREFIX="[Test] "

# R2, token 1: Object Read & Write on the two production buckets. The endpoint matches the buckets' jurisdiction
# (EU buckets: https://<account id>.eu.r2.cloudflarestorage.com).
S3_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=pesoprint-prod-public
S3_PRIVATE_BUCKET=pesoprint-prod-private
PUBLIC_ASSETS_URL=https://pesoprint-files.allulab.eu

# Sentry project pesoprint-api. The release comes from the image.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
