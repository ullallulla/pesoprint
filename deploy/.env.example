# Host settings for the production stack (docs/production-environment3.md §2.1, §5). Copy to /opt/pesoprint/.env.
# The image tag isn't set here: bin/compose takes it from the release (sha-<commit>).

# Which optional parts run on this host:
#   tunnel        Cloudflare Tunnel in front of Caddy (homelab; or a VPS without open ports)
#   postgres      Postgres in the stack (leave it out for a managed database and set DATABASE_URL in api.env)
#   backup        nightly encrypted database dump to R2 (env/backup.env)
#   files-backup  nightly copy of the R2 buckets off Cloudflare (env/files-backup.env)
COMPOSE_PROFILES=tunnel,postgres,backup,files-backup

# Behind a tunnel or a load balancer, only the main file: Caddy listens on :80 inside the stack.
COMPOSE_FILE=docker-compose.prod.yml
# tls mode (Cloudflare's proxy → Caddy on 443 with the Origin certificate in env/certs/), without "tunnel" above:
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.tls.yml

# Who may tell Caddy the visitor's IP and scheme. Behind a tunnel or a load balancer: private_ranges (only they can
# reach Caddy). In tls mode, Cloudflare's IP ranges (check https://www.cloudflare.com/ips/ for changes):
TRUSTED_PROXIES=private_ranges
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# The public host names Caddy answers for.
SITE_HOST=pesoprint.allulab.eu
HOOKS_HOST=pesoprint-hooks.allulab.eu

# Where the app images come from (ghcr.io/<owner>/pesoprint-api and -web).
IMAGE_REPO=ghcr.io/ullallulla

# files-backup with a local destination: the host directory it writes to (mounted as /backup). It must be writable
# by uid 70, the backup image's user: `chown 70:70 <dir>`.
FILES_BACKUP_DIR=/mnt/pesoprint-files-backup
